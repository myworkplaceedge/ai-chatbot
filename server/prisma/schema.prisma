generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("PRISMA_DATABASE_URL")
}

model Session {
  id        String      @id @default(cuid())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  Message[]
  intents   IntentLog[]
}

model Message {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])
  role      String
  content   String
  createdAt DateTime @default(now())
  ratings   Rating[]
}

model Rating {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id])
  value     String   // "thumbs_up" or "thumbs_down"
  createdAt DateTime @default(now())
}

model IntentLog {
  id           String   @id @default(cuid())
  sessionId    String
  session      Session  @relation(fields: [sessionId], references: [id])
  intent       String
  docsSelected String
  createdAt    DateTime @default(now())
}

model Lesson {
  id        String   @id @default(cuid())
  name      String
  content   String
  // JSON-encoded array of { title, url? } objects parsed from the lesson on
  // upload. Nullable so legacy rows and lessons without handouts stay clean.
  handouts  String?
  createdAt DateTime @default(now())
}
